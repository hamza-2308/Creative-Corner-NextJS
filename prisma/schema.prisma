generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  UNDER_REVIEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  whatsapp  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  features    String
  price       Int?
  image       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[]
}

model Package {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  included    String
  price       Int
  image       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[]
}

model Event {
  id          String   @id @default(cuid())
  name        String
  type        String
  date        DateTime
  location    String
  description String
  images      String
  services    String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  image     String
  description String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutContent {
  id          String   @id @default(cuid())
  storyTitle  String   @default("Small ideas can become extraordinary moments.")
  storyText1  String   @default("Creative Corner brings together event planners, designers, coordinators and production partners to deliver celebrations and business events with confidence.")
  storyText2  String   @default("Our mission is simple: create meaningful experiences without putting the pressure of coordination on our clients.")
  storyImage  String   @default("/images/about-story.svg")
  teamImage   String   @default("/images/about-team.svg")
  mission     String   @default("Deliver thoughtful, reliable and creative event experiences.")
  vision      String   @default("Become the trusted event partner for celebrations and businesses.")
  whyUs       String   @default("Transparent planning, professional teams and complete coordination.")
  updatedAt   DateTime @updatedAt
}

model Booking {
  id                 String        @id @default(cuid())
  reference          String        @unique
  clientId           String
  serviceId          String?
  packageId          String?
  eventType          String
  eventName          String
  eventDate          DateTime
  guests             Int
  venue              String
  address            String
  city               String
  area               String
  locationDetails    String?
  decoration         String?
  catering           String?
  photography        String?
  stage              String?
  lighting           String?
  specialInstructions String?
  status             BookingStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service            Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package            Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model Inquiry {
  id        String         @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
